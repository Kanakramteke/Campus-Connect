datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  college      String
  phone        String?
  profileImage String?
  interests    String?  // JSON formatted array string
  role         String   @default("STUDENT") // STUDENT, EVENT_ORGANIZER, CLUB_HEAD, COMMUNITY_ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registrations  Registration[]
  clubMembers    ClubMember[]
  communityMemb CommunityMember[]
  bookmarks      Bookmark[]
  notifications  Notification[]
}

model Event {
  id              String   @id @default(uuid())
  title           String
  category        String   // TECHNICAL or CULTURAL
  tagline         String?
  description     String
  image           String?
  date            String
  time            String
  location        String
  venue           String
  registrationFee Float    @default(0)
  isFree          Boolean  @default(true)
  seats           Int      @default(100)
  eligibility     String?
  organizedBy     String
  college         String
  creatorId       String
  status          String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  whatToExpect    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  registrations Registration[]
  bookmarks     Bookmark[]
}

model Registration {
  id                 String   @id @default(uuid())
  eventId            String
  studentId          String
  registrationId     String   @unique
  registrationStatus String   @default("confirmed") // confirmed, cancelled
  paymentStatus      String   @default("free") // free, paid, pending, failed
  paymentMethod      String   @default("Free")
  amountPaid         Float    @default(0)
  transactionId      String?
  registeredAt       DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
}

model Club {
  id           String   @id @default(uuid())
  name         String
  category     String   // TECHNICAL, CULTURAL, OTHER
  college      String
  description  String
  image        String?
  membersCount Int      @default(1)
  activities   String?  // JSON string
  leadership   String?  // JSON string
  creatorId    String
  status       String   @default("PUBLISHED") // DRAFT, PUBLISHED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members ClubMember[]
}

model ClubMember {
  id       String   @id @default(uuid())
  clubId   String
  userId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}

model Community {
  id          String   @id @default(uuid())
  name        String
  category    String
  college     String
  description String
  image       String?
  interests   String?  // JSON string
  creatorId   String
  status      String   @default("PUBLISHED") // DRAFT, PUBLISHED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members CommunityMember[]
  posts   Post[]
}

model CommunityMember {
  id          String   @id @default(uuid())
  communityId String
  userId      String
  joinedAt    DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
}

model Post {
  id            String   @id @default(uuid())
  communityId   String
  authorId      String
  authorName    String
  authorCollege String
  authorAvatar  String?
  title         String
  content       String
  likesCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  community Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     PostLike[]
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Comment {
  id            String   @id @default(uuid())
  postId        String
  authorId      String
  authorName    String
  authorCollege String
  authorAvatar  String?
  content       String
  createdAt     DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Notification {
  id                String   @id @default(uuid())
  userId            String
  category          String   // events, clubs, communities, payments, system
  type              String?
  title             String
  message           String
  isRead            Boolean  @default(false)
  relatedEntityType String?  // event, club, community
  relatedEntityId   String?
  actionRoute       String?
  actionParams      String?  // JSON string
  actionLabel       String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}
